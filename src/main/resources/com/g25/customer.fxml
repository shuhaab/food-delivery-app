<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_LEFT" spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.g25.CustomerController"
    stylesheets="@base.css, @customer.css">
    <HBox fx:id="navbarContent" alignment="TOP_LEFT">
    </HBox>

    <HBox spacing="10.0">
        <VBox>
            <Label text="Credits" />
            <Label fx:id="creditsLabel" />
        </VBox>
        <Button text="topup" fx:id="topupButton" />
    </HBox>

    <HBox spacing="5.0">
        <Button fx:id="menuButton" text="Menu" />
        <Button fx:id="reviewsButton" text="View reviews" />
        <Button fx:id="ordersButton" text="Order history" />
        <Button fx:id="transactionsButton" text="Transaction history" />
        <Button fx:id="complaintsButton" text="View complaints" />
        <Button fx:id="notificationsButton" text="Notifications" />
        <Button fx:id="cartButton" text="Cart" />
    </HBox>

        <VBox fx:id="content" VBox.vgrow="ALWAYS">
        </VBox>

    <!-- <padding>
        <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
    </padding> -->
</VBox>