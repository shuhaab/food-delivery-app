<VBox alignment="TOP_LEFT" spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.g25.RunnerController" stylesheets="@base.css, @runner.css">
    <HBox fx:id="navbarContent" alignment="TOP_LEFT">
    </HBox>
    
    <HBox>
        <Button fx:id="tasksButton" text="Tasks" />
