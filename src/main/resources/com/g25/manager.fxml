<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_LEFT" spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.g25.ManagerController" stylesheets="@base.css, @manager.css">
    <HBox fx:id="navbarContent" alignment="TOP_LEFT">
    </HBox>
    
    <HBox spacing="5.0">
        <Button fx:id="vendorPerformanceButton" text="Vendor performance" />
        <Button fx:id="runnerPerformanceButton" text="Runner performance" />
        <Button fx:id="resolveComplaintsButton" text="Resolve complaints" />
        <Button fx:id="discardVendorItemButton" text="Discard vendor items" />
    </HBox>
    
    <VBox fx:id="content" VBox.vgrow="ALWAYS">
    </VBox>
</VBox>
